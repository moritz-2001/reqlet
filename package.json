{
  "name": "reqlet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "node scripts/build-wasm.mjs && vite",
    "build:wasm": "node scripts/build-wasm.mjs",
    "generate:json": "lezer-generator --typeScript --noTerms --output src/json/parser.ts src/json/grammar.grammar",
    "test": "pnpm build:wasm && node --test tests/*.test.mjs && vitest run",
    "build": "pnpm build:wasm && vue-tsc --noEmit && vite build",
    "build:linux": "tauri build --bundles deb",
    "preview": "vite preview",
    "perf:indentation": "node scripts/json-indentation-performance.mjs",
    "perf:formatting": "pnpm build:wasm && node scripts/json-formatting-performance.mjs",
    "perf:search": "pnpm build:wasm && node scripts/body-search-performance.mjs",
    "perf:ui": "node scripts/ui-performance.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.5",
    "@lezer/lr": "^1.4.11",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2",
    "vue": "^3.5.13",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@lezer/generator": "^1.8.1",
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.5.1",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.5"
  }
}
